generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/mongodb"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  email         String           @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  bio           String?
  availableForWork Boolean        @default(false)
  role          String           @default("EMPLOYEE")
  companyId     String?          @db.ObjectId
  company       Company?         @relation("CompanyUsers", fields: [companyId], references: [id])
  memberships   ProjectMember[]
  assignedTasks Task[]
  updates       ProjectUpdate[]
  deliverables  Deliverable[]
  comments      Comment[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  createdReports ProgressReport[] @relation("ReportAuthor")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Company {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  users     User[]    @relation("CompanyUsers")
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  companyId    String          @db.ObjectId
  company      Company         @relation(fields: [companyId], references: [id])
  status       String          @default("ACTIVE")
  startDate    DateTime?
  dueDate      DateTime?
  progress     Int             @default(0)
  members      ProjectMember[]
  tasks        Task[]
  milestones   Milestone[]
  updates      ProjectUpdate[]
  deliverables Deliverable[]
activityLogs ActivityLog[]
  reports     ProgressReport[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ProjectMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Task {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String?
  status        String           @default("TO_DO")
  priority      String           @default("MEDIUM")
  assigneeId    String?          @db.ObjectId
  assignee      User?            @relation(fields: [assigneeId], references: [id])
  projectId     String           @db.ObjectId
  project       Project          @relation(fields: [projectId], references: [id])
  dueDate       DateTime?
  clientVisible Boolean          @default(false)
  updates       ProjectUpdate[]  @relation("TaskUpdates")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([projectId])
  @@index([assigneeId])
}

model Milestone {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  dueDate   DateTime?
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}

model ProjectUpdate {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  body       String
  progress   Int             @default(0)
  visibility String          @default("CLIENT")
  fileUrl    String?
  projectId  String          @db.ObjectId
  project    Project         @relation(fields: [projectId], references: [id])
  authorId   String          @db.ObjectId
  author     User            @relation(fields: [authorId], references: [id])
  taskId     String?         @db.ObjectId
  task       Task?           @relation("TaskUpdates", fields: [taskId], references: [id])
  comments   Comment[]       @relation("UpdateComments")
  reports    ReportUpdate[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([projectId])
}

model Deliverable {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  fileUrl      String?
  deliveryLink String?
  status       String      @default("DRAFT")
  feedback     String?
  projectId    String      @db.ObjectId
  project      Project     @relation(fields: [projectId], references: [id])
  uploaderId   String      @db.ObjectId
  uploader     User        @relation(fields: [uploaderId], references: [id])
  comments     Comment[]   @relation("DeliverableComments")
  reports     ReportDeliverable[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([projectId])
}

model Comment {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  body          String
  authorId      String          @db.ObjectId
  author        User            @relation(fields: [authorId], references: [id])
  deliverableId String?         @db.ObjectId
  deliverable   Deliverable?    @relation("DeliverableComments", fields: [deliverableId], references: [id])
  updateId      String?         @db.ObjectId
  update        ProjectUpdate?  @relation("UpdateComments", fields: [updateId], references: [id])
  createdAt     DateTime        @default(now())

  @@index([deliverableId])
  @@index([updateId])
}

model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  detail    String?
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ProgressReport {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  intro        String?
  token        String              @unique
  enabled      Boolean             @default(true)
  expiresAt    DateTime?
  projectId    String              @db.ObjectId
  project      Project             @relation(fields: [projectId], references: [id])
  createdById  String              @db.ObjectId
  createdBy    User                @relation("ReportAuthor", fields: [createdById], references: [id])
  updates      ReportUpdate[]
  deliverables ReportDeliverable[]
  comments     PublicComment[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([projectId])
}

model ReportUpdate {
  id       String         @id @default(auto()) @map("_id") @db.ObjectId
  reportId String         @db.ObjectId
  updateId String         @db.ObjectId
  report   ProgressReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  update   ProjectUpdate  @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@unique([reportId, updateId])
}

model ReportDeliverable {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  reportId      String         @db.ObjectId
  deliverableId String         @db.ObjectId
  report        ProgressReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  deliverable   Deliverable    @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@unique([reportId, deliverableId])
}

model PublicComment {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  reportId   String         @db.ObjectId
  report     ProgressReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorName String
  body       String
  status     String         @default("PENDING")
  ipHash     String
  createdAt  DateTime       @default(now())

  @@index([reportId, status])
}