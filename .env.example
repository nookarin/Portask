# Local development (docker-compose.yml)
DATABASE_URL=postgresql://portask:portask@db:5432/portask
JWT_SECRET=super-secret-change-me-in-production
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# First admin account, created on the first boot of the built image.
# Public signup only ever creates CLIENT accounts; ADMIN/EMPLOYEE are created by this
# admin (POST /api/users) or by this bootstrap.
ADMIN_EMAIL=admin@portask.dev
ADMIN_PASSWORD=admin123
ADMIN_NAME=Ari Admin

# Production (docker-compose.prod.yml)
POSTGRES_PASSWORD=portask
JWT_SECRET=super-secret-change-me-in-production
FRONTEND_URL=http://localhost
IMAGE_NAMESPACE=your-github-user
IMAGE_TAG=latest
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Administrator
# Reverse-proxy hops in front of the API (1 = the bundled nginx; 2 = nginx behind a
# TLS-terminating load balancer). Needed for Secure cookies and real client IPs.
TRUST_PROXY=1
# Empty = the session cookie is Secure only on HTTPS requests (recommended).
# true = always Secure. false = never Secure (plain-HTTP deployments only).
COOKIE_SECURE=